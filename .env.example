# 应用配置
APP_NAME=stock-academy
DEBUG=false
ENVIRONMENT=development

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/stock_academy
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5433/stock_academy

# Redis (MVP 可选)
REDIS_URL=redis://localhost:6380/0

# Tushare Pro Token（历史数据源，注册地址: https://tushare.pro）
TUSHARE_TOKEN=your_token_here

# 行情数据 API 超时（秒）
STOCK_API_TIMEOUT=10
